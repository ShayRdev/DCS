{
  "name": "loop-monitor",
  "version": "1.1.0",
  "private": true,
  "description": "Loop Monitor desktop app for Raspberry Pi + ADS1115 Rosemount readings",
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^29.0.0",
    "wait-on": "^7.0.1"
  },
  "scripts": {
    "start": "BROWSER=none concurrently -k \"react-scripts start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "start:web": "BROWSER=none react-scripts start",
    "build": "react-scripts build",
    "electron": "electron .",
    "electron:prod": "electron ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
